// 3. Variables de Control de Estado
let currentQuestionIndex = 0;
let totalScore = 0;

// 4. Elementos del DOM
const startScreen = document.getElementById("start-screen");
const quizScreen = document.getElementById("quiz-screen");
const resultScreen = document.getElementById("result-screen");

const startBtn = document.getElementById("start-btn");
const restartBtn = document.getElementById("restart-btn");

const questionText = document.getElementById("question-text");
const optionsContainer = document.getElementById("options-container");
const progressBar = document.getElementById("progress");

const resultTitle = document.getElementById("result-title");
const resultDesc = document.getElementById("result-desc");

// 5. Event Listeners de Flujo principal
startBtn.addEventListener("click", () => {
    startScreen.classList.add("hidden");
    quizScreen.classList.remove("hidden");
    loadQuestion();
});

restartBtn.addEventListener("click", () => {
    resultScreen.classList.add("hidden");
    startScreen.classList.remove("remove"); // O reset directo al quiz
    currentQuestionIndex = 0;
    totalScore = 0;
    quizScreen.classList.remove("hidden");
    loadQuestion();
});

// 6. Funciones de Lógica
function loadQuestion() {
    const currentQuestion = questions[currentQuestionIndex];
    questionText.innerText = currentQuestion.question;
    optionsContainer.innerHTML = "";
    
    // Actualizar barra de progreso
    const progressPercent = (currentQuestionIndex / questions.length) * 100;
    progressBar.style.width = `${progressPercent}%`;

    // Renderizar botones de opción de respuesta
    currentQuestion.options.forEach(option => {
        const button = document.createElement("button");
        button.innerText = option.text;
        button.addEventListener("click", () => selectOption(option.pts));
        optionsContainer.appendChild(button);
    });
}

function selectOption(pts) {
    totalScore += pts;
    currentQuestionIndex++;

    if (currentQuestionIndex < questions.length) {
        loadQuestion();
    } else {
        showResult();
    }
}

function showResult() {
    quizScreen.classList.add("hidden");
    resultScreen.classList.remove("hidden");
    progressBar.style.width = "100%";

    // El puntaje mínimo posible es 9 (todo opciones de menor puntaje) 
    // El puntaje máximo posible es 41 (todo opciones de mayor puntaje)
    // Dividimos el rango de manera matemática para asignar uno de los 6 tipos.
    let selectedPersonality;

    if (totalScore >= 7 && totalScore <=9) {
        selectedPersonality = personalities[4]; // Carlos
    } else if (totalScore <= 11) {
        selectedPersonality = personalities[2]; // Vale
    } else if (totalScore <= 14) {
        selectedPersonality = personalities[0]; // Marco
    } else if (totalScore <= 15) {
        selectedPersonality = personalities[1]; // Caro
    } else if (totalScore <= 16) {
        selectedPersonality = personalities[3]; // Chavi
    } else {
        selectedPersonality = personalities[5]; // Orne
    }

    resultTitle.innerText = selectedPersonality.title;
    resultDesc.innerText = selectedPersonality.desc;
}
